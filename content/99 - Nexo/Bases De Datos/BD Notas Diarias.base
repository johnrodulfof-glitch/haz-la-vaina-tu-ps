model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Tabla
    filters:
      and:
        - Tipo != "Nota Mensual"
        - Mes == this.file.name
    order:
      - file.name
      - Enfoque
    sort:
      - property: file.name
        direction: DESC
